generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Események tábla
model Event {
  id            Int            @id @default(autoincrement())
  title         String         // Esemény címe
  description   String?        // Leírás (opcionális)
  date          DateTime       // Dátum és idő
  location      String         // Helyszín
  createdAt     DateTime       @default(now())
  
  // Reláció: Egy eseményhez több jelentkezés is tartozhat
  registrations Registration[] 
}

// Jelentkezések tábla
model Registration {
  id        Int      @id @default(autoincrement())
  name      String   // Jelentkező neve
  email     String   // Jelentkező email címe
  createdAt DateTime @default(now())

  // Reláció: Melyik eseményhez tartozik
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}